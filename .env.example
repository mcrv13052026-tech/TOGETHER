# Runtime Environment
NODE_ENV=development
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# Security Secrets (Generate 32+ byte random hex/base64 values in production)
JWT_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=

# Database (MongoDB Atlas URI; if omitted locally, TogetherSpace uses local persistent storage)
MONGODB_URI=

# Google Drive OAuth 2.0 (Authorization Code Flow + PKCE)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Realtime Messaging & WebRTC Signaling (Ably; falls back to SSE locally when unset)
ABLY_API_KEY=

# Transactional Emails (Optional Resend integration)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=TogetherSpace <noreply@example.com>

# WebRTC TURN Relay Server (Managed TURN recommended for production NAT traversal)
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Scheduled Cleanup & Privacy Contact
CRON_SECRET=
PRIVACY_CONTACT_EMAIL=privacy@example.com
